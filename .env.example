# ---------------------------------------------------------------------------
# agent_system — environment configuration (TEMPLATE)
#
# Copy to `.env` and fill in your own values:   cp .env.example .env
# `.env` is read by Python at startup; it is NOT read by the agent's shell
# commands unless you export it yourself. Never commit the real .env.
# Placeholder values below are syntactically valid but are NOT valid credentials.
# ---------------------------------------------------------------------------

# --- Telegram (required to run the bot) ------------------------------------
# From @BotFather (/newbot). Keep this secret: it is registered as a secret at
# startup so it is masked in every log line. The bot refuses to start without it.
TELEGRAM_BOT_TOKEN=000000000:REPLACE_WITH_YOUR_BOT_TOKEN_FROM_BOTFATHER

# Your Telegram numeric user id, comma separated. EXACTLY the people allowed to
# control the bot. Find your id by messaging @userinfobot (third party: it sees
# your id and nothing else) or @getidsbot. NEVER guess, never use a username.
# Leave nothing after this value for a single user:  TELEGRAM_ALLOWED_USER_IDS=123456789
TELEGRAM_ALLOWED_USER_IDS=111111111,222222222

# --- Paths (optional) -------------------------------------------------------
# PROJECT_ROOT defaults to this repository's directory.
# OUTPUT_DIR defaults to <PROJECT_ROOT>/output — jobs, inbox, logs, selftests.
#PROJECT_ROOT=/Users/you/Projects/AI-Bots/AI AGENT FOR MY FATHER(new)
#OUTPUT_DIR=/Users/you/Projects/AI-Bots/AI AGENT FOR MY FATHER(new)/output

# --- Limits and safety ------------------------------------------------------
# Jobs rendered in parallel. 1 is safest while you are validating the pipeline.
MAX_CONCURRENT_JOBS=2
# Largest file (MB) the bot will accept from you OR try to send back.
# Telegram's Bot API accepts up to 50 MB per upload; the default below keeps a
# safety margin. Delivery above this limit switches to local-path delivery.
MAX_UPLOAD_MB=49
# Seconds the bot waits for your Approve/Cancel before it skips the render.
APPROVAL_TIMEOUT_SEC=900
# INFO | DEBUG | WARNING
LOG_LEVEL=INFO

# --- Rendering behaviour (optional) -----------------------------------------
# FAST_RENDER=true renders the whole film at 960x540 @24fps instead of the full
# resolution. Useful for a quick end-to-end check; leave false for deliverables.
FAST_RENDER=false
# AGENT_NO_RENDER=1 runs research, evidence and the script/storyboard only and
# starts NO renderer at all (no ffmpeg subprocess, no preview, no final video).
# The delivery report states plainly that no video was rendered. The headless
# equivalent is `python3 -m agent_system run-job --no-render ...`.
AGENT_NO_RENDER=0

# --- Optional enrichment (off by default) -----------------------------------
# The research/story/render workflow runs in-process and does NOT need OpenCode.
# Enabling this only lets the agent process use the configured research agent.
OPENCODE_ENABLED=false
#OPENCODE_BIN=opencode
#OPENCODE_MODEL=opencode/step-5-preview-free

# --- Notes ------------------------------------------------------------------
# * No dependency install is required for the Telegram path beyond what is
#   already installed (python-telegram-bot 21.6, Pillow, requests, ffmpeg).
# * 3D rendering additionally needs Blender (brew install --cask blender);
#   without it the style is reported as unavailable — never faked.
# * No Uzbek TTS engine exists on this machine: record narration yourself.

# Optional synthetic voice-over (off by default). Needs: pip install edge-tts
# Sends each scene's narration text to Microsoft's online speech service.
# AGENT_TTS=edge
